# backend/.env.example -- copy to backend/.env and fill in.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored. This file is NOT -- never put a real value here.
#
# WHY THIS FILE LIVES UNDER backend/ AND NOT AT THE REPO ROOT
# --------------------------------------------------------------------------
# Two config systems read it and both resolve to backend/.env when uvicorn is
# started with cwd=backend (which is what the README's `fastapi dev app/main.py`
# does):
#
#   app/core/config.py  pydantic BaseSettings, env_file=".env", env_prefix FORGE_
#   app/config.py       the legacy forge-control loader, REPO_ROOT = backend/
#
# They are NOT interchangeable. Only app/config.py._load_env() copies values
# into os.environ, and every module migrated out of the old forge/ package --
# llm, triage, planner, telemetry, brightdata, vcs -- reads os.getenv, much of
# it at import time. app/__init__.py imports both loaders for that reason.
#
# Several credentials therefore appear under TWO spellings below. That is
# deliberate, not duplication to clean up: the two config systems disagree on
# names, and until they are unified both have to be set.

# ── app identity ─────────────────────────────────────────────────────────
FORGE_PROJECT_NAME=FORGE
FORGE_EVENT_NAME=FORGE Zero Downtime Hackathon
FORGE_DATABASE_PATH=data/forge.db
FORGE_AUDIT_INTERVAL_SECONDS=300

# ── operator login ───────────────────────────────────────────────────────
# Defaults are admin / forge-local. Override all three anywhere shared.
FORGE_AUTH_USERNAME=admin
FORGE_AUTH_PASSWORD=change-me
FORGE_AUTH_SECRET=change-me

# ── target app (Pulse) ───────────────────────────────────────────────────
# Point this at the Pulse THIS checkout serves. If a second FORGE instance is
# running on 8100, do not aim at it -- the audit loop would grade someone
# else's app and open fix runs against it.
PULSE_BASE_URL=http://localhost:8100
AUDIT_INTERVAL_SECONDS=300
AUDIT_ROUTES=/,/products,/security
SCRAPE_INTERVAL_SECONDS=900
PORT_GATE_MODE=poll

# ── human gate ───────────────────────────────────────────────────────────
# Must stay 0. A person sees every regenerated collector and every patch.
FORGE_AUTO_APPROVE=0

# ── LLM ──────────────────────────────────────────────────────────────────
# anthropic or openai. llm.provider() falls back to the other one if the
# preferred provider has no key, so set the key that matches.
FORGE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
FORGE_ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FORGE_OPENAI_API_KEY=
# Optional per-role overrides. Unset = llm.DEFAULT_MODELS for the provider:
#   anthropic  triage claude-haiku-4-5-20251001  planner claude-sonnet-5
#   openai     triage gpt-5.6-luna               planner gpt-5.6-terra
# FORGE_TRIAGE_MODEL=
# FORGE_PLANNER_MODEL=
FORGE_PLANNER_MAX_TOKENS=8000
FORGE_OPENAI_REASONING_EFFORT=low
FORGE_TOKEN_HEADROOM=1.6
FORGE_BUDGET_USD=25
FORGE_FIX_COOLDOWN_SECONDS=1800

# ── Port ─────────────────────────────────────────────────────────────────
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
FORGE_PORT_CLIENT_ID=
FORGE_PORT_CLIENT_SECRET=
# https://api.getport.io -- or https://api.us.port.io on the US tenant.
PORT_API_BASE=https://api.getport.io

# ── SigNoz ───────────────────────────────────────────────────────────────
SIGNOZ_INGESTION_KEY=
FORGE_SIGNOZ_INGESTION_KEY=
# us | us2 | eu | in -- must match the ingest host below.
SIGNOZ_REGION=us
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
# Spans POST to <this>/v1/traces. Leave blank to disable span export.
FORGE_SIGNOZ_INGEST_BASE_URL=https://ingest.us.signoz.cloud
OTEL_SERVICE_NAME=forge-control

# ── Bright Data ──────────────────────────────────────────────────────────
# One credential, two spellings: the Scraper Studio CLI pipeline reads
# BRIGHTDATA_API_TOKEN, core/config.py reads BRIGHTDATA_API_KEY.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_API_KEY=
FORGE_BRIGHTDATA_API_KEY=
# Pinned collector. Never create a new one -- generation takes 5-10 minutes.
BOOKS_COLLECTOR_ID=c_mt4y9wy817vo82ojy8
# Browser API / Selenium are SEPARATE Bright Data products from the Scraper
# Studio CLI above. Only /health/integrations uses them; leave blank unless
# you have those endpoints.
FORGE_BRIGHTDATA_BROWSER_WS_URL=
FORGE_BRIGHTDATA_SELENIUM_URL=

# ── GitHub ───────────────────────────────────────────────────────────────
# PR creation shells out to the `gh` CLI. Without gh on PATH, open_pr()
# returns a stub URL and no PR is created regardless of this token.
GITHUB_TOKEN=
GITHUB_REPO=k1lst1x/FORGE
