# Core app config
FORGE_PROJECT_NAME=FORGE
FORGE_EVENT_NAME=FORGE Zero Downtime Hackathon
FORGE_DATABASE_PATH=data/forge.db
FORGE_AUDIT_INTERVAL_SECONDS=60

# Port
PORT_CLIENT_ID=your_port_client_id
PORT_CLIENT_SECRET=your_port_client_secret
PORT_API_BASE=https://api.port.io
# or, if you log in to the US tenant: https://api.us.port.io
# FORGE_PORT_CLIENT_ID=your_port_client_id
# FORGE_PORT_CLIENT_SECRET=your_port_client_secret
# FORGE_PORT_API_BASE=https://api.port.io

# Bright Data
FORGE_BRIGHTDATA_API_KEY=your_brightdata_api_key
FORGE_BRIGHTDATA_BROWSER_WS_URL=wss://brd-customer-...:9222
FORGE_BRIGHTDATA_SELENIUM_URL=https://brd-customer-...:9515

# SigNoz
FORGE_SIGNOZ_INGESTION_KEY=your_signoz_ingestion_key
FORGE_SIGNOZ_INGEST_BASE_URL=https://ingest.<region>.signoz.cloud

# OpenAI
FORGE_OPENAI_API_KEY=your_openai_api_key
