{
  "blueprints": [
    {
      "identifier": "page",
      "title": "Page",
      "icon": "Microservice",
      "schema": {
        "properties": {
          "route": { "type": "string", "title": "Route" },
          "title": { "type": "string", "title": "Title" },
          "generated_by_run": { "type": "string", "title": "Generated by run" },
          "grade": {
            "type": "string",
            "title": "Audit grade",
            "enum": ["Gold", "Silver", "Bronze"]
          },
          "open_findings_high": { "type": "number", "title": "Open HIGH findings" },
          "open_findings_med": { "type": "number", "title": "Open MED findings" },
          "tests_passing": { "type": "boolean", "title": "Tests passing" },
          "last_verified_at": { "type": "string", "format": "date-time", "title": "Last verified" }
        },
        "required": ["route"]
      }
    },
    {
      "identifier": "finding",
      "title": "Finding",
      "icon": "Alert",
      "schema": {
        "properties": {
          "check_id": { "type": "string", "title": "Check" },
          "severity": { "type": "string", "enum": ["HIGH", "MED", "LOW"] },
          "route": { "type": "string", "title": "Route" },
          "evidence": { "type": "string", "title": "Evidence" },
          "status": { "type": "string", "title": "Status" },
          "justification": { "type": "string", "title": "Justification" }
        },
        "required": ["check_id", "severity", "route"]
      }
    },
    {
      "identifier": "factory_run",
      "title": "Factory run",
      "icon": "Deployment",
      "schema": {
        "properties": {
          "intake": { "type": "string", "enum": ["brief", "finding"] },
          "stage": { "type": "string", "title": "Stage" },
          "status": { "type": "string", "title": "Status" },
          "trace_id": { "type": "string", "title": "Trace ID" },
          "classification": { "type": "string", "title": "Triage" },
          "should_act": { "type": "boolean", "title": "Should act" },
          "pr_url": { "type": "string", "format": "url", "title": "Pull request" },
          "files_changed": { "type": "number", "title": "Files changed" },
          "tests_passed": { "type": "boolean", "title": "Tests passed" },
          "duration_ms": { "type": "number", "title": "Duration (ms)" },
          "approver": { "type": "string", "title": "Approver" },
          "signoz_url": { "type": "string", "format": "url", "title": "SigNoz trace" }
        },
        "required": ["intake", "status"]
      }
    },
    {
      "identifier": "project",
      "title": "Project",
      "icon": "Home",
      "schema": {
        "properties": {
          "goal": { "type": "string", "title": "Goal" },
          "technical_choices": { "type": "string", "title": "Technical choices" },
          "known_risks": { "type": "string", "title": "Risk factors" },
          "cataloged_services": {
            "type": "array",
            "items": { "type": "string" },
            "title": "Cataloged services"
          }
        },
        "required": ["goal", "technical_choices", "known_risks"]
      }
    }
  ]
}
