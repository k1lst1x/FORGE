  "spec": {
    "display": {
      "name": "FORGE Loop B",
      "description": "Five panels. A stranger should see what is wrong in under ten seconds. Resist a sixth."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "route",
            "description": "Pulse route the factory registered in Port"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "none",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": { "name": "route", "signal": "metrics" }
          },
          "name": "route"
        }
      }
    ],
    "panels": {
      "a1a1a1a1-1111-4111-8111-111111111111": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "1 · Security grade over time, per route",
            "description": "forge_security_grade. Gold=3 Silver=2 Bronze=1. Injection is a cliff; the fix is a recovery."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": { "timePreference": "global_time", "fillSpans": true },
              "formatting": { "unit": "none", "decimalPrecision": "0" },
              "chartAppearance": {
                "lineInterpolation": "linear",
                "showPoints": true,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": { "fillOnlyBelow": false, "fillLessThan": "" }
              },
              "axes": { "softMin": 1, "softMax": 3, "isLogScale": false },
              "legend": { "position": "bottom", "mode": "list", "customColors": null },
              "thresholds": [
                { "value": 2, "label": "Silver", "color": "#d97706" }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "forge_security_grade",
                              "temporality": "",
                              "timeAggregation": "min",
                              "spaceAggregation": "min",
                              "reduceTo": "min"
                            }
                          ],
                          "disabled": false,
                          "filter": { "expression": "route IN $route" },
                          "groupBy": [{ "key": { "name": "route" } }],
                          "order": [],
                          "limit": 30,
                          "having": { "expression": "" },
                          "functions": [],
                          "legend": "{{route}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
