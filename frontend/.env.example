# frontend/.env.example
#
# Copy to frontend/.env and fill in. Vite only exposes variables prefixed
# VITE_ to the browser, so anything here is PUBLIC once built -- put only
# publishable values in it, never a service-role key or a database password.
#
#   cp frontend/.env.example frontend/.env
#
# frontend/.env is gitignored.


# ── Supabase Auth ────────────────────────────────────────────────────────
# Supabase dashboard -> Project Settings -> API
#
#   VITE_SUPABASE_URL       "Project URL"
#   VITE_SUPABASE_ANON_KEY  the "anon" / publishable key
#
# The anon key is designed to be shipped in client code -- it is protected by
# Row Level Security, not by secrecy. The service_role key is NOT: it bypasses
# RLS entirely and must never appear in this file or anywhere under frontend/.
#
# Leave both blank and the dashboard runs open, showing "auth not configured"
# in the top bar. Set both and it gates on a real session.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# ── API ──────────────────────────────────────────────────────────────────
# Where the React app (src/App.tsx) sends its requests. Defaults to
# http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Where the dashboard console sends its requests. Leave blank for same-origin
# (/api/...). Set it when forge-control runs on another port -- the dev proxy
# strips /api, which forge-control does not expect.
VITE_FORGE_CONTROL_URL=
